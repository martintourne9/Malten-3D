{
  "rewrites": [
    { "source": "/printcost3d", "destination": "/printcost3d/index.html" }
  ],
  "headers": [
    {
      "source": "/printcost3d/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
